.DS_Store
fish-demo/pretext/
fish-demo/fish-src.js
fish-demo/node_modules/

# Capture masters. This repo is public and served, and git keeps every byte
# forever — a 76MB screen recording would live in the clone of anyone who
# ever touches the site. Keep masters local; commit the web encode only
# (Assets/openprose-loop.mp4, 1.3MB, made with:
#   ffmpeg -i <master> -map 0:v:0 -an -sn -dn -write_tmcd 0 -map_metadata -1 \
#     -vf "scale=1280:-2:flags=lanczos" -c:v libx264 -profile:v high \
#     -pix_fmt yuv420p -crf 27 -preset slow -movflags +faststart out.mp4)
openprose/Assets/openproseloop.mp4

# Dev-time tooling deps (scripts/build-chunk-vectors.mjs). Never committed —
# the site itself stays zero-build.
node_modules/
package-lock.json
package.json

# Rendered social pack — regenerate with `node scripts/render-media-kit.mjs` (13 MB of PNGs, not source)
Assets/media-kit/

# Local-only working notes (interview answers, drafts with personal detail). Never committed.
.local/

# Agent worktrees. Claude Code creates these INSIDE the repo, so without this
# every parallel session shows up as untracked noise in `git status` — and a
# stray `git add -A` would commit a whole second checkout. This lived only in
# .git/info/exclude, which is machine-local: correct on John's Mac, wrong in
# every fresh clone.
.claude/worktrees/

# Art + photo MASTERS (2026-10-05). The web encodes beside them are what the
# site serves and what gets committed: Assets/photos/*.webp, Assets/art/*.webp,
